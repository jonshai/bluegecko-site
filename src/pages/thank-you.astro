---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You | Blue Gecko">
  <main class="section">
    <div class="container">
      <div class="card">
        <h1>We got it — thank you.</h1>
        <p>
          Someone from our team will be in touch soon. We take response time
          seriously, so expect to hear from us within one business day — usually
          much sooner.
        </p>
        <p>
          While you wait, feel free to browse what's available on the Space Coast.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.25rem;">
          <a href="/" class="button button-primary">Back to Home</a>
          <a href="/search" class="button">Browse Listings</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
