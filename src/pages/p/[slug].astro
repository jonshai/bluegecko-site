---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthor } from '../../data/authors';
import type { AuthorName } from '../../data/authors';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';

const { slug } = Astro.params;

const entries = await getCollection('prospecting');
const entry = entries.find(e => e.id === slug);

if (!entry) {
  return Astro.redirect('/404', 404);
}

const d = entry.data;

// Expiry check
const today = new Date();
today.setHours(0, 0, 0, 0);
const expiry = new Date(d.expiry_date);
expiry.setHours(0, 0, 0, 0);
const isExpired = today > expiry;

// Author
const author = getAuthor(d.agent as AuthorName);

// Compile a markdown string to an HTML string using the remark/rehype pipeline.
// allowDangerousHtml passes raw HTML blocks (gallery <img> tags) through unchanged.
async function compileMd(md: string): Promise<string> {
  const file = await unified()
    .use(remarkParse)
    .use(remarkGfm)
    .use(remarkRehype, { allowDangerousHtml: true })
    .use(rehypeStringify, { allowDangerousHtml: true })
    .process(md);
  return String(file);
}

// Replace {{gallery:N}} markers with HTML before compilation.
// Runs of 2–3 consecutive markers (any whitespace between them, including blank lines)
// are wrapped in a .gallery-pair grid div. Single markers remain standalone <figure> blocks.
const galleryImages = d.gallery_images ?? [];
function resolveGalleryMarkers(md: string): string {
  // Step 1: detect runs of 2+ consecutive markers separated by any whitespace
  md = md.replace(
    /\{\{gallery:\d+\}\}(?:\s*\n\s*\{\{gallery:\d+\}\})+/g,
    (runMatch: string) => {
      const hits = [...runMatch.matchAll(/\{\{gallery:(\d+)\}\}/g)];
      const count = Math.min(hits.length, 3);
      const figures = hits.slice(0, count).map(([, n]) => {
        const img = galleryImages[parseInt(n, 10) - 1];
        if (!img) return '';
        return `<figure class="section-figure"><img src="${img}" alt="" class="section-gallery-img" loading="lazy" /></figure>`;
      }).join('');
      return `\n\n<div class="gallery-pair gallery-pair-${count}">${figures}</div>\n\n`;
    }
  );
  // Step 2: resolve remaining single markers
  return md.replace(/\{\{gallery:(\d+)\}\}/g, (_match: string, n: string) => {
    const img = galleryImages[parseInt(n, 10) - 1];
    if (!img) return '';
    return `\n\n<figure class="section-figure"><img src="${img}" alt="" class="section-gallery-img" loading="lazy" /></figure>\n\n`;
  });
}

// Split body on the ::: section delimiter and render each chunk.
// Normalize surrounding blank lines first so the split is robust regardless of YAML formatting.
const rawBody = entry.body ?? '';
const normalized = rawBody.replace(/\n*:::\n*/g, '\n:::\n');
const sectionTexts = normalized.split('\n:::\n').map((s: string) => s.trim()).filter(Boolean);

// ── DIAGNOSTIC LOG (temporary) ────────────────────────────────────────────────
console.log(`[diag] entry.body type: ${typeof entry.body}, length: ${rawBody.length}`);
console.log(`[diag] section count after split: ${sectionTexts.length}`);
console.log(`[diag] rawBody first 120 chars: ${JSON.stringify(rawBody.slice(0, 120))}`);
const gallerySection = sectionTexts.find((s: string) => s.includes('{{gallery:2}}'));
if (gallerySection) {
  const g2pos = gallerySection.indexOf('{{gallery:2}}');
  const g3pos = gallerySection.indexOf('{{gallery:3}}');
  const between = g3pos > -1 ? gallerySection.slice(g2pos + 13, g3pos) : '(gallery:3 not in same section)';
  console.log(`[diag] section containing gallery:2 index: ${sectionTexts.indexOf(gallerySection)}`);
  console.log(`[diag] chars between {{gallery:2}} and {{gallery:3}}: ${JSON.stringify(between)}`);
} else {
  console.log('[diag] {{gallery:2}} not found in any section after split');
  console.log(`[diag] normalized body (first 500): ${JSON.stringify(normalized.slice(0, 500))}`);
}
// ── END DIAGNOSTIC LOG ────────────────────────────────────────────────────────
const sectionHtml = await Promise.all(
  sectionTexts.map((s: string) => compileMd(resolveGalleryMarkers(s)))
);

// Escape a value for safe embedding inside an inline <script>.
function escJs(val: string): string {
  return JSON.stringify(val).replace(/<\/script>/gi, '<\\/script>');
}
---

<BaseLayout
  title={isExpired ? 'Blue Gecko — Analysis Expired' : `${d.headline} | Blue Gecko`}
  description={isExpired ? 'This property analysis has expired.' : `${d.address} · ${d.cma_range}`}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <main>
    <section class="section prospect-page">
      <div class="container prospect-container">

        {isExpired ? (
          <div class="expired-wrap">
            <div class="card expired-card">
              <h1>This analysis has expired.</h1>
              <p>
                This property analysis was prepared for {d.address} and is no
                longer available. If you'd like a fresh market assessment, we're
                happy to help.
              </p>
              <button data-stella-trigger="open" class="button button-primary">
                Get an Updated Assessment
              </button>
            </div>
          </div>
        ) : (
          <>
            {/* Hero image */}
            {d.hero_image ? (
              <div class="prospect-hero">
                <img src={d.hero_image} alt={d.address} class="prospect-hero-img" />
                <div class="prospect-hero-overlay">
                  <p class="prospect-address">{d.address}</p>
                </div>
              </div>
            ) : (
              <p class="prospect-address-plain">{d.address}</p>
            )}

            {/* Headline + CMA range badge */}
            <div class="prospect-lede">
              <h1 class="prospect-headline">{d.headline}</h1>
              <span class="cma-badge">{d.cma_range}</span>
            </div>

            {/* Body — each ::: section wrapped in a card */}
            {sectionHtml.map((html: string) => (
              <div class="card prose-section" set:html={html} />
            ))}

            {/* Agent byline */}
            {author && (
              <div class="card agent-byline">
                <img
                  src={author.photo}
                  alt={author.name}
                  class="agent-photo"
                  loading="lazy"
                />
                <div>
                  <p class="agent-name">{author.name}</p>
                  <p class="agent-bio">{author.bio}</p>
                </div>
              </div>
            )}

            {/* Lead capture CTA */}
            <div class="card cta-card" id="contact">
              <h2>The next move is yours.</h2>
              <p class="cta-intro">
                If you're ready to get your house sold, let us know and we'll reach out shortly.
              </p>
              <form id="prospect-cta-form" novalidate>
                <input type="hidden" name="formType" value="seller" />
                <input type="hidden" name="redirectTo" value="/thank-you" />
                <div class="cta-row">
                  <label class="cta-field">
                    <span class="cta-label-text">Name</span>
                    <input type="text" name="name" value={d.prospect_name} class="cta-input" autocomplete="name" />
                  </label>
                  <label class="cta-field">
                    <span class="cta-label-text">Email</span>
                    <input type="email" name="email" class="cta-input" autocomplete="email" />
                  </label>
                </div>
                <label class="cta-field">
                  <span class="cta-label-text">Phone</span>
                  <input type="tel" name="phone" class="cta-input" autocomplete="tel" />
                </label>
                <label class="cta-field">
                  <span class="cta-label-text">Notes <span class="cta-optional">(optional)</span></span>
                  <textarea name="message" rows="2" class="cta-input"></textarea>
                </label>
                <div id="cta-error" class="cta-error-msg" hidden></div>
                <button type="submit" class="button button-primary cta-submit-btn">Let's talk</button>
                <p class="cta-disclaimer">
                  By submitting, I agree to be contacted by Jennifer Lee Whipple, LLC via call,
                  email, and text for real estate services. Message and data rates may apply.
                  Reply STOP to opt out. View our <a href="/privacy">Privacy Policy</a>.
                </p>
              </form>
            </div>
          </>
        )}

      </div>
    </section>
  </main>
</BaseLayout>

{/* Silent page-view tracking — maps to existing /api/lead endpoint.
    Reads the ?p= query param (print/postcard source number) and sends
    a seller event so the notification email logs the visit.
    No UI change, no redirect. Fires once on DOMContentLoaded. */}
<script is:inline set:html={`(function () {
  var prospectName = ${escJs(d.prospect_name)};
  var pageSlug     = ${escJs(entry.id)};
  document.addEventListener('DOMContentLoaded', function () {
    var p = new URLSearchParams(location.search).get('p');
    var source = p ? ('BG Web - P' + p) : 'BG Web - direct';
    var fd = new FormData();
    fd.append('formType', 'seller');
    fd.append('name', prospectName);
    fd.append('message', source);
    fd.append('slug', pageSlug);
    fetch('/api/lead', { method: 'POST', body: fd }).catch(function () {});
  });
})();`} />

<script is:inline>
(function () {
  var form = document.getElementById('prospect-cta-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = form.querySelector('.cta-submit-btn');
    var errEl = document.getElementById('cta-error');
    var fd = new FormData(form);
    var name  = (fd.get('name')  || '').trim();
    var email = (fd.get('email') || '').trim();
    var phone = (fd.get('phone') || '').trim();

    errEl.hidden = true;
    errEl.textContent = '';

    if (!name) {
      errEl.textContent = 'Please enter your name.';
      errEl.hidden = false;
      return;
    }
    if (!email && !phone) {
      errEl.textContent = 'Please enter an email address or phone number.';
      errEl.hidden = false;
      return;
    }

    btn.disabled = true;
    var origText = btn.textContent;
    btn.textContent = 'Sending\u2026';

    fetch('/api/lead', { method: 'POST', body: fd })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.redirect) {
          window.location.href = data.redirect;
        } else {
          btn.disabled = false;
          btn.textContent = origText;
          errEl.textContent = 'Something went wrong. Please try again.';
          errEl.hidden = false;
        }
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = origText;
        errEl.textContent = 'Network error. Please try again.';
        errEl.hidden = false;
      });
  });
})();
</script>

<style>
  .prospect-page {
    padding-bottom: 4rem;
  }

  /* Narrow reading column — these are personal letters, not wide-layout pages */
  .prospect-container {
    max-width: 820px;
  }

  /* ── Hero ── */
  .prospect-hero {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 1.75rem;
  }

  .prospect-hero-img {
    width: 100%;
    aspect-ratio: 16 / 6;
    object-fit: cover;
    display: block;
  }

  .prospect-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.1rem 1.5rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, transparent 100%);
  }

  .prospect-address {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: white;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .prospect-address-plain {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  /* ── Headline + CMA badge ── */
  .prospect-lede {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .prospect-headline {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand);
    line-height: 1.3;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .cma-badge {
    flex-shrink: 0;
    background: var(--brand);
    color: white;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    white-space: nowrap;
    align-self: center;
  }

  /* ── Body sections — each ::: chunk wrapped in .card ── */
  .prose-section {
    margin-bottom: 1.25rem;
    font-size: 0.97rem;
    line-height: 1.78;
    color: var(--text);
  }

  .prose-section :global(h1),
  .prose-section :global(h2) {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--brand);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .prose-section :global(h3) {
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.25rem 0 0.45rem;
  }

  .prose-section :global(p) {
    margin: 0 0 0.85rem;
  }

  .prose-section :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose-section :global(ul),
  .prose-section :global(ol) {
    padding-left: 1.35rem;
    margin: 0 0 0.85rem;
  }

  .prose-section :global(li) {
    margin-bottom: 0.3rem;
  }

  .prose-section :global(strong) {
    font-weight: 700;
  }

  .prose-section :global(em) {
    font-style: italic;
  }

  .prose-section :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 1.25rem 0;
  }

  .prose-section :global(a) {
    color: var(--brand);
    border-bottom: 1px solid rgba(31, 92, 77, 0.3);
  }

  .prose-section :global(a:hover) {
    border-bottom-color: var(--brand);
  }

  /* Gallery images injected via {{gallery:N}} markers */
  .prose-section :global(.section-figure) {
    margin: 1rem 0;
  }

  .prose-section :global(.section-gallery-img) {
    width: 100%;
    border-radius: var(--radius);
    display: block;
    object-fit: cover;
    max-height: 480px;
  }

  /* Side-by-side gallery pairs */
  .prose-section :global(.gallery-pair) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .prose-section :global(.gallery-pair-3) {
    grid-template-columns: repeat(3, 1fr);
  }

  .prose-section :global(.gallery-pair .section-gallery-img) {
    max-height: 320px;
  }

  @media (max-width: 640px) {
    .prose-section :global(.gallery-pair),
    .prose-section :global(.gallery-pair-3) {
      grid-template-columns: 1fr;
    }
  }

  /* ── Agent byline ── */
  .agent-byline {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .agent-photo {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .agent-name {
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 0.25rem;
    color: var(--text);
  }

  .agent-bio {
    font-size: 0.83rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin: 0;
  }

  /* ── CTA card ── */
  .cta-card {
    margin-top: 1.25rem;
  }

  .cta-card h2 {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--brand);
    margin: 0 0 0.45rem;
  }

  .cta-intro {
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text-soft);
    margin: 0 0 1.25rem;
  }

  /* ── CTA form ── */
  .cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .cta-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.75rem;
  }

  .cta-label-text {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text);
  }

  .cta-optional {
    font-weight: 400;
    color: var(--text-soft);
  }

  .cta-input {
    font-family: inherit;
    font-size: 0.88rem;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 0.5rem 0.65rem;
    background: #fafaf8;
    color: var(--text);
    width: 100%;
  }

  .cta-input:focus {
    outline: none;
    border-color: var(--brand);
  }

  textarea.cta-input {
    resize: vertical;
  }

  .cta-error-msg {
    font-size: 0.85rem;
    color: #8b3a1a;
    background: #fff0eb;
    border: 1px solid #f4c0a8;
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .cta-submit-btn {
    margin-bottom: 1rem;
  }

  .cta-disclaimer {
    font-size: 0.76rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin: 0;
  }

  .cta-disclaimer a {
    color: var(--text-soft);
    text-decoration: underline;
  }

  @media (max-width: 540px) {
    .cta-row {
      grid-template-columns: 1fr;
    }
  }

  /* ── Expired state ── */
  .expired-wrap {
    max-width: 540px;
    margin: 4rem auto;
  }

  .expired-card {
    text-align: center;
  }

  .expired-card h1 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .expired-card p {
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text-soft);
    margin: 0 0 1.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .prospect-headline {
      font-size: 1.2rem;
    }

    .prospect-lede {
      flex-direction: column;
      gap: 0.5rem;
    }

    .cma-badge {
      align-self: flex-start;
    }
  }
</style>
