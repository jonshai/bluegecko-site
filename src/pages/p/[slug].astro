---
export const prerender = false;

import { getCollection } from 'astro:content';
import AVMSidebar from '../../components/AVMSidebar.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';

const { slug } = Astro.params;

const entries = await getCollection('outreach');
const entry = entries.find(e => e.id === slug);

if (!entry) {
  return Astro.redirect('/404', 404);
}

const d = entry.data;

// Expiry check
const today = new Date();
today.setHours(0, 0, 0, 0);
const expiry = new Date(d.expiry_date + 'T00:00:00');
const isExpired = today > expiry;

// Bucket-specific heading for action plan
const actionPlanHeading: Record<string, string> = {
  pricing: 'Our Pricing Strategy',
  marketing: 'Our Marketing Plan',
  condition: 'Our Improvement Plan',
  timing: 'Why Now?',
};
const planHeading = actionPlanHeading[d.bucket] || 'Our Plan';

// CTA copy
const ctaCopy: Record<string, string> = {
  appointment: 'Schedule a Free Consultation',
  call: 'Call Us Today',
  reply: 'Send Us a Message',
};
const ctaText = ctaCopy[d.cta_type] || 'Get in Touch';

// Fire page_visit event (server-side fire-and-forget)
fetch(new URL('/api/outreach-event', Astro.url), {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({
    event: 'page_visit',
    slug: d.slug,
    property_address: d.property_address,
    utm_source: d.utm_source,
    fub_contact_id: d.fub_contact_id,
    timestamp: new Date().toISOString(),
  }),
}).catch(() => {});

function fmt(n: number): string {
  return '$' + n.toLocaleString('en-US');
}

// Escape a value for safe embedding as a JS string literal inside an inline <script>.
// JSON.stringify produces a quoted, escaped string; the </script> replacement prevents
// early tag termination.
function escJs(val: string): string {
  return JSON.stringify(val).replace(/<\/script>/gi, '<\\/script>');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Blue Gecko — {isExpired ? 'Analysis Expired' : d.headline}</title>
    <meta name="description" content={isExpired ? 'This property analysis has expired.' : d.opening_narrative.slice(0, 160)} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="stylesheet" href="/global.css" />
    <script>
      window.__OUTREACH_CONFIG__ = {
        slug: document.location.pathname.split('/p/')[1] || '',
        property_address: document.title,
      };
    </script>
    <script src="/outreach-events.js" defer></script>
    <script is:inline set:html={`(function () {
  "use strict";
  var sellerName      = ${escJs(d.owner_name)};
  var propertyAddress = ${escJs(d.property_address)};
  var contextType     = "expired_listing_outreach";
  var captureGoalsRaw = '["email","phone","consent","appointment"]';
  var captureGoals = [];
  try {
    var parsed = JSON.parse(captureGoalsRaw);
    if (Array.isArray(parsed)) { captureGoals = parsed; }
  } catch (e) {}
  var ctx = {
    seller_name:      sellerName,
    property_address: propertyAddress,
    context:          contextType,
    capture_goals:    captureGoals
  };
  window.STELLA_CONTEXT = ctx;
  try {
    sessionStorage.setItem("stella_context", JSON.stringify(ctx));
  } catch (e) {}
})();`} />
  </head>
  <body class="outreach-page">
    <!-- Minimal brand header (no nav, no CB strip) -->
    <header class="p-header">
      <div class="p-container p-header-inner">
        <a href="/" class="p-brand">
          <img src="/bg_logo_stroke.png" alt="Blue Gecko Homes" class="p-logo" />
        </a>
        <span class="p-private-badge">Private Analysis</span>
      </div>
    </header>

    <main class="p-main">
      <div class="p-container">

        {isExpired ? (
          <!-- Expired state -->
          <div class="expired-card card">
            <h1 class="expired-heading">This analysis has expired.</h1>
            <p class="expired-body">
              This personalized property analysis was prepared for {d.property_address} and is
              no longer available. If you'd like an updated market analysis, reach out to the
              Blue Gecko team — we're happy to help.
            </p>
            <button data-stella-trigger="open" class="button button-primary">
              Get an Updated Assessment
            </button>
          </div>
        ) : (
          <!-- Active state -->
          <div class="p-layout">
            <!-- Left: main content column -->
            <div class="p-content">

              <!-- Hero image -->
              {d.hero && (
                <div class="p-hero-wrap">
                  <img src={d.hero} alt={d.property_address} class="p-hero-img" />
                  <div class="p-hero-overlay">
                    <h1 class="p-property-address">{d.property_address}</h1>
                  </div>
                </div>
              )}

              {!d.hero && (
                <h1 class="p-property-address p-property-address--no-hero">{d.property_address}</h1>
              )}

              <!-- Headline -->
              <h2 class="p-headline">{d.headline}</h2>

              <!-- Opening narrative -->
              <p class="p-narrative">{d.opening_narrative}</p>

              <!-- AI rendering (if present) -->
              {d.ai_rendering && (
                <div class="p-rendering-wrap">
                  <p class="p-rendering-caption">Rendering — what this home could look like with improvements</p>
                  <img src={d.ai_rendering} alt="AI rendering" class="p-rendering-img" loading="lazy" />
                </div>
              )}

              <!-- Before/After gallery -->
              {d.before_after && d.before_after.length > 0 && (
                <BeforeAfter pairs={d.before_after} />
              )}

              <!-- Gallery -->
              {d.gallery && d.gallery.length > 0 && (
                <div class="p-gallery">
                  {d.gallery.map((img: string, i: number) => (
                    <img src={img} alt={`${d.property_address} photo ${i + 1}`} loading="lazy" class="p-gallery-img" />
                  ))}
                </div>
              )}

              <!-- Strategy block -->
              <section class="p-section">
                <h3 class="p-section-heading">Market Context</h3>
                <p class="p-prose">{d.strategy_block}</p>
              </section>

              <!-- Action plan -->
              <section class="p-section">
                <h3 class="p-section-heading">{planHeading}</h3>
                <ol class="p-action-plan">
                  {d.action_plan.map((step: string) => (
                    <li class="p-step">{step}</li>
                  ))}
                </ol>
              </section>

              <!-- Outbound links -->
              {d.outbound_links && d.outbound_links.length > 0 && (
                <section class="p-section">
                  <h3 class="p-section-heading">Useful Links</h3>
                  <ul class="p-outbound-links">
                    {d.outbound_links.map((link: { label: string; url: string }) => (
                      <li>
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="p-outbound-link"
                          onclick={`window.fireOutreachEvent && window.fireOutreachEvent('outbound_click', { outbound_label: '${link.label.replace(/'/g, "\\'")}' })`}
                        >
                          {link.label} →
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              <!-- Seller contact form -->
              <section class="p-section p-contact-section" id="contact">
                <h3 class="p-section-heading">Ready to Talk?</h3>
                <p class="p-prose p-contact-intro">
                  This analysis was prepared just for you. There's no obligation — we'd love
                  to walk through it together and answer any questions.
                </p>

                <form class="p-form" id="outreach-contact-form" novalidate>
                  <input type="hidden" name="slug" value={d.slug} />
                  <input type="hidden" name="property_address" value={d.property_address} />
                  <input type="hidden" name="utm_source" value={d.utm_source || ''} />
                  {d.fub_contact_id && (
                    <input type="hidden" name="fub_contact_id" value={d.fub_contact_id} />
                  )}

                  <div class="form-row">
                    <label for="oc-name">Your Name</label>
                    <input type="text" id="oc-name" name="name" autocomplete="name" placeholder="First Last" />
                  </div>
                  <div class="form-row">
                    <label for="oc-email">Email</label>
                    <input type="email" id="oc-email" name="email" autocomplete="email" placeholder="you@example.com" />
                  </div>
                  <div class="form-row">
                    <label for="oc-phone">Phone</label>
                    <input type="tel" id="oc-phone" name="phone" autocomplete="tel" placeholder="321-555-0000" />
                  </div>

                  <p class="form-consent">
                    By submitting you agree to be contacted by Jennifer Lee Whipple, LLC via call,
                    email, and text. Reply STOP to opt out of texts. Reply HELP for help.
                    Message &amp; data rates may apply.
                  </p>

                  <button type="submit" class="button button-primary p-submit-btn">
                    {ctaText}
                  </button>
                  <p class="form-status" id="oc-status" aria-live="polite"></p>
                </form>
              </section>

              <!-- PDF download -->
              {d.pdf_link && (
                <div class="p-pdf-row">
                  <a
                    href={d.pdf_link}
                    class="button button-secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="window.fireOutreachEvent && window.fireOutreachEvent('pdf_download')"
                  >
                    Download PDF Version
                  </a>
                </div>
              )}

            </div>

            <!-- Right: AVM sidebar -->
            <aside class="p-sidebar">
              <AVMSidebar
                avm_sources={d.avm_sources}
                avm_midpoint={d.avm_midpoint}
                recommended_price={d.recommended_price}
              />

              <!-- Primary CTA button -->
              <a
                href={d.cta_url}
                class="button button-primary p-cta-btn"
                onclick="window.fireOutreachEvent && window.fireOutreachEvent('cta_click')"
              >
                {ctaText}
              </a>

              <!-- Agent card -->
              <div class="agent-card card">
                <p class="agent-name">William &amp; Lucky Whipple</p>
                <p class="agent-sub">Blue Gecko · Coldwell Banker Realty</p>
                <p class="agent-sub">FL Lic. #3535381 / #3535380</p>
                <a href="tel:+13213416650" class="agent-phone">321.341.6650</a>
              </div>
            </aside>
          </div>
        )}
      </div>
    </main>

    <footer class="p-footer">
      <div class="p-container">
        <p class="p-footer-text">
          © {new Date().getFullYear()} Blue Gecko, a Coldwell Banker Realty Team ·
          <a href="/privacy">Privacy Policy</a>
        </p>
        <p class="p-footer-fine">
          This analysis is for informational purposes only and does not constitute a legally binding
          appraisal or offer. All information is deemed reliable but not guaranteed.
        </p>
      </div>
    </footer>

    <script>
      // Outreach contact form handler
      const form = document.getElementById('outreach-contact-form') as HTMLFormElement | null;
      const status = document.getElementById('oc-status');

      if (form) {
        form.addEventListener('submit', async (e: Event) => {
          e.preventDefault();
          if (!status) return;
          status.textContent = '';

          const data: Record<string, string> = {};
          const fd = new FormData(form);
          fd.forEach((val, key) => { data[key] = String(val); });

          if (!data.name && !data.email && !data.phone) {
            status.textContent = 'Please fill in at least one contact field.';
            return;
          }

          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          if (submitBtn) submitBtn.disabled = true;

          try {
            const res = await fetch('/api/outreach-contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            const json = await res.json() as { ok: boolean; error?: string };
            if (json.ok) {
              status.textContent = "Got it — we'll be in touch soon!";
              form.reset();
              if (window.fireOutreachEvent) {
                window.fireOutreachEvent('contact_form_submit');
              }
            } else {
              status.textContent = json.error || 'Something went wrong. Please try again.';
              if (submitBtn) submitBtn.disabled = false;
            }
          } catch {
            status.textContent = 'Network error. Please try again.';
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* ── Global reset for outreach page ── */
  .outreach-page {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg, #f7f6f2);
    color: var(--text, #1e2a26);
  }

  .p-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* ── Header ── */
  .p-header {
    background: white;
    border-bottom: 1px solid #e0ddd5;
    padding: 0.75rem 0;
  }

  .p-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .p-logo {
    height: 48px;
    width: auto;
    display: block;
  }

  .p-private-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent, #c96f4a);
    background: rgba(201, 111, 74, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  /* ── Main layout ── */
  .p-main {
    padding: 2rem 0 3rem;
  }

  .p-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }

  /* ── Hero ── */
  .p-hero-wrap {
    position: relative;
    border-radius: var(--radius, 18px);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .p-hero-img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    display: block;
  }

  .p-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 100%);
  }

  .p-property-address {
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
    margin: 0;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }

  .p-property-address--no-hero {
    color: var(--text, #1e2a26);
    margin-bottom: 1rem;
    font-size: 1.6rem;
  }

  /* ── Typography ── */
  .p-headline {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--brand, #1f5c4d);
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .p-narrative {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text, #1e2a26);
    margin-bottom: 2rem;
  }

  .p-section {
    margin-bottom: 2.5rem;
  }

  .p-section-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text, #1e2a26);
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--brand, #1f5c4d);
    display: inline-block;
  }

  .p-prose {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text, #1e2a26);
    margin: 0 0 1rem;
  }

  /* ── Action plan ── */
  .p-action-plan {
    padding-left: 1.5rem;
    margin: 0;
  }

  .p-step {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.6rem;
    color: var(--text, #1e2a26);
  }

  /* ── Outbound links ── */
  .p-outbound-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .p-outbound-links li {
    margin-bottom: 0.4rem;
  }

  .p-outbound-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--brand, #1f5c4d);
    text-decoration: none;
  }

  .p-outbound-link:hover {
    text-decoration: underline;
  }

  /* ── Gallery ── */
  .p-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
    margin: 2rem 0;
  }

  .p-gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius, 18px);
    display: block;
  }

  /* ── AI rendering ── */
  .p-rendering-wrap {
    margin: 1.5rem 0 2rem;
  }

  .p-rendering-caption {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--text-soft, #5a6b65);
    margin: 0 0 0.5rem;
  }

  .p-rendering-img {
    width: 100%;
    border-radius: var(--radius, 18px);
    display: block;
  }

  /* ── Contact form ── */
  .p-contact-section {
    background: white;
    border-radius: var(--radius, 18px);
    padding: 1.75rem;
  }

  .p-contact-intro {
    margin-bottom: 1.25rem;
  }

  .p-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-row label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text, #1e2a26);
  }

  .form-row input {
    padding: 0.6rem 0.85rem;
    border: 1.5px solid #ccc;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text, #1e2a26);
    background: #fafaf8;
  }

  .form-row input:focus {
    outline: none;
    border-color: var(--brand, #1f5c4d);
  }

  .form-consent {
    font-size: 0.72rem;
    color: var(--text-soft, #5a6b65);
    line-height: 1.5;
    margin: 0;
  }

  .p-submit-btn {
    align-self: flex-start;
  }

  .form-status {
    font-size: 0.85rem;
    color: var(--brand, #1f5c4d);
    min-height: 1.2em;
    margin: 0;
  }

  /* ── PDF row ── */
  .p-pdf-row {
    margin-top: 1.5rem;
  }

  /* ── Sidebar ── */
  .p-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 1.5rem;
  }

  .p-cta-btn {
    width: 100%;
    text-align: center;
  }

  .agent-card {
    padding: 1.25rem;
    background: white;
  }

  .agent-name {
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.2rem;
    color: var(--text, #1e2a26);
  }

  .agent-sub {
    font-size: 0.8rem;
    color: var(--text-soft, #5a6b65);
    margin: 0 0 0.15rem;
  }

  .agent-phone {
    display: block;
    margin-top: 0.6rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--brand, #1f5c4d);
    text-decoration: none;
  }

  .agent-phone:hover {
    text-decoration: underline;
  }

  /* ── Expired card ── */
  .expired-card {
    max-width: 580px;
    margin: 3rem auto;
    padding: 2.5rem;
    text-align: center;
    background: white;
  }

  .expired-heading {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text, #1e2a26);
    margin-bottom: 1rem;
  }

  .expired-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-soft, #5a6b65);
    margin-bottom: 1.5rem;
  }

  /* ── Footer ── */
  .p-footer {
    background: #0c2a4a;
    color: white;
    padding: 1.25rem 0;
  }

  .p-footer-text {
    font-size: 0.82rem;
    margin: 0 0 0.4rem;
  }

  .p-footer-text a {
    color: white;
    text-decoration: underline;
  }

  .p-footer-fine {
    font-size: 0.72rem;
    opacity: 0.7;
    margin: 0;
    max-width: 680px;
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .p-layout {
      grid-template-columns: 1fr;
    }

    .p-sidebar {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .p-property-address {
      font-size: 1.15rem;
    }

    .p-headline {
      font-size: 1.15rem;
    }
  }
</style>
