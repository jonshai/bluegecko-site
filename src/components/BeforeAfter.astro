---
interface Pair {
  before: string;
  after: string;
  label?: string;
}

interface Props {
  pairs: Pair[];
}

const { pairs } = Astro.props;
---

{pairs.length > 0 && (
  <div class="before-after-wrap">
    {pairs.map(pair => (
      <div class="ba-pair">
        {pair.label && <p class="ba-label">{pair.label}</p>}
        <div class="ba-cols">
          <div class="ba-col">
            <img src={pair.before} alt="Before" loading="lazy" class="ba-img" />
            <span class="ba-caption">Before</span>
          </div>
          <div class="ba-col">
            <img src={pair.after} alt="After" loading="lazy" class="ba-img" />
            <span class="ba-caption">After</span>
          </div>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .before-after-wrap {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 2rem 0;
  }

  .ba-pair {
    /* nothing extra */
  }

  .ba-label {
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
    color: var(--text);
  }

  .ba-cols {
    display: flex;
    gap: 0.75rem;
  }

  .ba-col {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .ba-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius, 18px);
    display: block;
  }

  .ba-caption {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft, #5a6b65);
  }

  @media (max-width: 480px) {
    .ba-cols {
      flex-direction: column;
    }

    .ba-img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
