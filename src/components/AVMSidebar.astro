---
interface AvmSource {
  name: string;
  value: number;
  date_pulled: string;
}

interface Props {
  avm_sources: AvmSource[];
  avm_midpoint: number;
  recommended_price: number;
}

const { avm_sources, avm_midpoint, recommended_price } = Astro.props;

const values = avm_sources.map(s => s.value);
const avm_low = Math.min(...values);
const avm_high = Math.max(...values);

function fmt(n: number): string {
  return '$' + n.toLocaleString('en-US');
}

// Compute bar positions as percentages.
// The track spans from display_low to display_high.
// If recommended is outside the AVM range, extend accordingly.
const display_low = Math.min(avm_low, recommended_price);
const display_high = Math.max(avm_high, recommended_price);
const display_range = display_high - display_low || 1;

function pct(value: number): number {
  return Math.round(((value - display_low) / display_range) * 100);
}

const lowPct = pct(avm_low);
const highPct = pct(avm_high);
const midPct = pct(avm_midpoint);
const recPct = pct(recommended_price);

// AVM track width within the display range
const trackLeft = lowPct;
const trackWidth = highPct - lowPct;

const recAbove = recommended_price > avm_high;
const recBelow = recommended_price < avm_low;
---

<aside class="avm-sidebar card">
  <h3 class="avm-title">What the Market Says</h3>

  <div class="avm-bar-wrap">
    <!-- Background track (full display range) -->
    <div class="bar-bg"></div>

    <!-- AVM range track -->
    <div
      class="bar-track"
      style={`left: ${trackLeft}%; width: ${trackWidth}%;`}
    ></div>

    <!-- Dashed extension if recommended is outside range -->
    {recBelow && (
      <div
        class="bar-ext bar-ext-left"
        style={`left: ${recPct}%; width: ${lowPct - recPct}%;`}
      ></div>
    )}
    {recAbove && (
      <div
        class="bar-ext bar-ext-right"
        style={`left: ${highPct}%; width: ${recPct - highPct}%;`}
      ></div>
    )}

    <!-- Low marker -->
    <div class="bar-marker marker-low" style={`left: ${lowPct}%;`}>
      <div class="marker-dot"></div>
      <span class="marker-label label-below">Low<br/>{fmt(avm_low)}</span>
    </div>

    <!-- Midpoint marker -->
    <div class="bar-marker marker-mid" style={`left: ${midPct}%;`}>
      <div class="marker-dot"></div>
      <span class="marker-label label-above">Mid<br/>{fmt(avm_midpoint)}</span>
    </div>

    <!-- High marker -->
    <div class="bar-marker marker-high" style={`left: ${highPct}%;`}>
      <div class="marker-dot"></div>
      <span class="marker-label label-below">High<br/>{fmt(avm_high)}</span>
    </div>

    <!-- Recommended price marker -->
    <div class="bar-marker marker-rec" style={`left: ${recPct}%;`}>
      <div class="marker-dot marker-dot-rec"></div>
      <span class="marker-label label-above rec-label">Our Rec.<br/>{fmt(recommended_price)}</span>
    </div>
  </div>

  <div class="avm-sources">
    <p class="sources-heading">AVM Sources</p>
    {avm_sources.map(s => (
      <div class="source-row">
        <span class="source-name">{s.name}</span>
        <span class="source-value">{fmt(s.value)}</span>
        <span class="source-date">{s.date_pulled}</span>
      </div>
    ))}
  </div>

  <div class="avm-rec-block">
    <span class="rec-label-text">Recommended List Price</span>
    <span class="rec-price">{fmt(recommended_price)}</span>
  </div>
</aside>

<style>
  .avm-sidebar {
    background: #f0f7f4;
    border: none;
    padding: 1.5rem;
  }

  .avm-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand, #1f5c4d);
    margin: 0 0 1.5rem;
  }

  /* ── Bar visualization ── */
  .avm-bar-wrap {
    position: relative;
    height: 56px;
    margin: 2rem 0 2.5rem;
  }

  .bar-bg {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    transform: translateY(-50%);
    background: #ddd;
    border-radius: 2px;
  }

  .bar-track {
    position: absolute;
    top: 50%;
    height: 8px;
    transform: translateY(-50%);
    background: var(--brand, #1f5c4d);
    border-radius: 4px;
    opacity: 0.35;
  }

  .bar-ext {
    position: absolute;
    top: 50%;
    height: 4px;
    transform: translateY(-50%);
    border-top: 2px dashed var(--accent, #c96f4a);
  }

  /* Markers */
  .bar-marker {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .marker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand, #1f5c4d);
    position: relative;
    z-index: 2;
  }

  .marker-dot-rec {
    background: var(--accent, #c96f4a);
    width: 14px;
    height: 14px;
    box-shadow: 0 0 0 3px rgba(201, 111, 74, 0.2);
  }

  .marker-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
    line-height: 1.3;
    color: var(--text);
  }

  .label-above {
    bottom: calc(100% + 4px);
  }

  .label-below {
    top: calc(100% + 4px);
  }

  .rec-label {
    color: var(--accent, #c96f4a);
  }

  /* ── AVM source table ── */
  .avm-sources {
    margin-bottom: 1.25rem;
    border-top: 1px solid #dde9e5;
    padding-top: 1rem;
  }

  .sources-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-soft, #5a6b65);
    margin: 0 0 0.5rem;
  }

  .source-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.82rem;
    padding: 0.2rem 0;
    border-bottom: 1px solid #eee;
  }

  .source-name {
    flex: 1;
    font-weight: 600;
    color: var(--text);
  }

  .source-value {
    font-weight: 700;
    color: var(--brand, #1f5c4d);
  }

  .source-date {
    font-size: 0.72rem;
    color: var(--text-soft, #5a6b65);
  }

  /* ── Recommended price callout ── */
  .avm-rec-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--accent, #c96f4a);
    color: white;
    border-radius: var(--radius, 18px);
    padding: 0.75rem 1rem;
    margin-top: 0.5rem;
  }

  .rec-label-text {
    font-size: 0.82rem;
    font-weight: 700;
    opacity: 0.9;
  }

  .rec-price {
    font-size: 1.15rem;
    font-weight: 800;
  }
</style>
